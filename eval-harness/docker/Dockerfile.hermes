# syntax=docker/dockerfile:1

# Build (from this docker/ directory), pointing at your local hermes-agent
# clone via HERMES_SRC_DIR:
#   docker build -f Dockerfile.hermes \
#     --build-context hermes-src="$HERMES_SRC_DIR" \
#     -t eval-harness/hermes:pinned .
#
# Run: see run-case.sh.
#
# Single-stage, editable (`-e`) install -- not a size choice, a hard
# requirement. Hermes's own build backend refuses to build a wheel/sdist at
# all: "Building wheels or sdists for hermes-agent is not supported...
# Hermes is distributed via the shell installer, Docker image, or Nix. If
# you are developing, use an editable install instead" -- hit verbatim when
# this file briefly tried a non-editable, multi-stage build (RuntimeError,
# confirmed against a real build, not assumed). Editable mode means the
# venv just points back at the source tree rather than containing real
# copies of it, so that tree has to be present at runtime too -- true
# multi-stage separation (copy only the finished venv, drop the monorepo
# checkout) isn't achievable against this package as currently distributed.

FROM python:3.14-slim

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        curl ca-certificates git bash ripgrep xz-utils && \
    rm -rf /var/lib/apt/lists/*

# Pinned, not "latest" -- otherwise a rebuild months from now silently
# picks up a different uv, and any behavior change shows up as a mystery
# build failure disconnected from anything actually changed here. Current
# release verified via `pip3 index versions uv` at the time this was
# pinned; bump deliberately, not by dropping the version pin.
RUN pip install --no-cache-dir uv==0.12.19

# The user the container actually runs as (see USER near the bottom). Fixed
# UID/GID rather than a build arg matching a host user -- nothing here
# needs that: /case-src is read-only regardless of who reads it, and /case
# is populated by entrypoint.sh's own copy, not by a bind mount. On native
# Linux (not Docker Desktop's macOS/Windows VM), if a case's evidence files
# are somehow restricted to a specific host UID rather than world-readable,
# reads from /case-src could still fail -- not expected with this repo's
# fixture data, but worth knowing if it ever comes up.
RUN groupadd --gid 1000 hermes && \
    useradd --uid 1000 --gid hermes --create-home --shell /bin/bash hermes

# Sourced from the "hermes-src" named build context, i.e. whatever local
# clone HERMES_SRC_DIR pointed at when this image was built -- not fetched
# or cloned in this Dockerfile. Whatever commit that checkout was on is
# what gets built; there is no independent pin recorded inside the image
# itself, so track which commit you built against alongside the image tag.
# Placed under the non-root user's home because that is also where Hermes
# itself will look for its own runtime state (~/.hermes) once it's running
# as `hermes`, not `root`.
ENV HERMES_HOME=/home/hermes/.hermes
COPY --from=hermes-src . "$HERMES_HOME/hermes-agent"

RUN cd "$HERMES_HOME/hermes-agent" && \
    uv venv .venv --python 3.14 && \
    . .venv/bin/activate && \
    uv pip install -e ".[all]"

RUN ln -sf "$HERMES_HOME/hermes-agent/.venv/bin/hermes" /usr/local/bin/hermes
RUN /usr/local/bin/hermes --version

# Case evidence is bind-mounted read-only at /case-src at `docker run` time
# (see run-case.sh: -v <case dir>:/case-src:ro). Hermes cannot work
# directly there: every case's TASK.md/AGENTS.md tells the agent to write
# QUESTION_ANSWERS.md "in this directory" -- i.e. alongside AGENTS.md
# itself -- which a `:ro` mount would refuse outright. entrypoint.sh copies
# /case-src into /case (a plain, writable, container-local directory that
# is never bind-mounted) before running the agent, so that write succeeds
# without the host's real evidence ever being mounted writable. Each
# container is single-use and discarded after one run, so the copy carries
# no cross-run contamination risk.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Everything the non-root user needs to read or write from here on: its own
# home (the venv, the editable-install source tree, and Hermes's own
# runtime state all live under there), and /case (entrypoint.sh's copy-out
# target -- created here so it exists with the right owner before
# WORKDIR/USER below, rather than appearing as a root-owned directory by
# accident of WORKDIR creating it implicitly).
RUN mkdir -p /case && chown -R hermes:hermes /home/hermes /case

WORKDIR /case
ENV HERMES_YOLO_MODE=1
ENV DO_NOT_TRACK=1
ENV PATH="/usr/local/bin:${PATH}"

USER hermes
# Re-run the sanity check as the user that will actually invoke this, not
# just as root during the earlier install step -- catches a permissions
# mistake in the chown above at build time instead of at first `docker run`.
RUN hermes --version

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
