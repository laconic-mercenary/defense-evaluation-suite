# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Your NousResearch/hermes-agent clone - ideally checked out to one 
# of the 
HERMES_SRC_DIR=/path/to/hermes-agent

# A directory already configured with Hermes's own `hermes setup` /
# `hermes model` -- run natively (e.g. `uv run hermes setup` from inside
# HERMES_SRC_DIR; set HERMES_HOME first if you don't want it touching your
# real ~/.hermes) to point it at whichever endpoint, Modal (dev) or on-prem
# (prod). run-case.sh mounts this read-only and copies it into the
# container's $HERMES_HOME -- your real directory is never modified.
# Switching dev/prod is maintaining two such directories and pointing this
# at whichever; this script has no separate dev/prod logic of its own.
HERMES_CONFIG_DIR=/path/to/your/configured/.hermes

# A directory of skill folders (each a name/ subdir with its own SKILL.md)
# to hand to Hermes. Whatever's in here gets copied into the container's
# $HERMES_HOME/skills/ and indexed by Hermes as-is -- run-case.sh/
# entrypoint.sh don't filter, curate, or care how many. Populating it (e.g.
# copying specific skills out of a mukul975/anthropic-cybersecurity-skills
# clone -- independent community project, not Anthropic-affiliated despite
# the name, see forensic-agent-answers/doc/TEST_OBJECTIVES.md) is on you.
SKILLS_DIR=/path/to/a/directory/of/skill/folders

# Egress lockdown: the ONLY hostname the container can reach at all once
# it's running (enforced by entrypoint.sh's iptables rules + local proxy,
# not just documented) -- your model endpoint's hostname, Modal in dev,
# on-prem in prod. Bare hostname only: no https://, no path, no port
# (e.g. laconic-mercenary--ep-qwen3-8-2-4t-01-server.us-west.modal.direct,
# not the full https://.../v1 base_url from config.yaml).
PROXY_ALLOWED_HOST=your-model-endpoint.example.com

# Web dashboard (config/API-key/session management -- NOT a live view of
# the investigation). Always runs, no toggle.
HERMES_DASHBOARD_PORT=9119

# Required for the dashboard to bind at all: a non-loopback bind (mandatory
# for a container's published port to reach it) refuses to start without an
# auth provider configured. This is the username/password provider -- see
# https://hermes-agent.nousresearch.com/docs/user-guide/features/web-dashboard
# for how to generate the scrypt password hash; a plaintext password here
# will not work.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
