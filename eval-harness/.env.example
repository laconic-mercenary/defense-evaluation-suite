# Judge configuration. Copy to .env (gitignored) and fill in.
# A variable already set in the environment wins over this file.

# Model as named by the server, e.g. Qwen/Qwen3-8B. Letters, digits, _ - . / :
JUDGE_MODEL_NAME=
# Server base URL, http(s) with a host, e.g. http://10.0.0.5:8000/v1
JUDGE_PROVIDER_URL=
# Model version, same characters as the model name
JUDGE_MODEL_VERSION=
# Repeats per rubric entry: integer 1-3
JUDGE_K=1
# Cap on tokens the model may write per reply: integer 256-32768. A plain
# JSON reply takes ~400; reasoning models' hidden thinking usually counts
# too, so raise it for those. A cut-off reply fails with a clear message.
JUDGE_MAX_TOKENS=2048
# Sampling temperature: 0.0-1.0
JUDGE_TEMPERATURE=0.0
# Extra HTTP headers sent with every model call: "Name=value; Name=value".
# Required: at least one (a tracing header is fine if the server needs no auth).
# Split on ";" between pairs and on the first "=" in each pair, so base64
# "==" padding is fine; a value can't contain ";". Content-Type is set by
# the harness and can't be given here. May hold credentials: never commit
# a real value.
JUDGE_HTTP_HEADERS=Authorization=Bearer <key>; X-Trace-Id=judge
